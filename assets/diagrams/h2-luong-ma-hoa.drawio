          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="bản mã" parent="1" edge="1" source="s5" target="wire" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="bản mã" parent="1" edge="1" source="wire" target="r1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="" parent="1" edge="1" source="r1" target="r2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;">
          <mxGeometry relative="1" as="geometry" />
