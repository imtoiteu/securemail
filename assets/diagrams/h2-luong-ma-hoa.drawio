<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="securemail-dossier" type="device">
  <diagram name="Luồng xử lý một bức thư mã hóa (gửi và nhận)" id="h2-luong-ma-hoa">
    <mxGraphModel dx="1180" dy="1180" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Luồng xử lý một bức thư mã hóa (gửi và nhận)" parent="1" vertex="1" style="text;html=1;align=center;fontSize=18;fontStyle=1;">
          <mxGeometry x="0" y="8" width="1180" height="30" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="&lt;b&gt;1. Soạn thư trong khung soạn thảo của Secure Mail&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Bản rõ nằm trong iframe của tiện ích, không nằm trong DOM của Gmail&lt;/font&gt;" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#1d4ed8;">
          <mxGeometry x="40" y="100" width="300" height="170" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="&lt;b&gt;2. Chọn người nhận&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Tra khóa công khai trong chùm khóa cục bộ&lt;/font&gt;" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#1d4ed8;">
          <mxGeometry x="40" y="300" width="300" height="140" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="&lt;b&gt;3. Kiểm tra khóa&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Đối chiếu dấu vân tay; cảnh báo nếu khóa hết hạn hoặc đã bị thu hồi&lt;/font&gt;" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#1d4ed8;">
          <mxGeometry x="40" y="470" width="300" height="160" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="&lt;b&gt;4. Mã hóa và ký số&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Khóa phiên AES-256, bọc bằng khóa công khai RSA-4096 của từng người nhận; ký bằng khóa riêng tư người gửi&lt;/font&gt;" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1e3a8a;fontStyle=1;">
          <mxGeometry x="40" y="660" width="300" height="210" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="&lt;b&gt;5. Giao cho Gmail&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Chỉ khối bản mã ASCII rời khỏi máy trạm&lt;/font&gt;" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#1d4ed8;">
          <mxGeometry x="40" y="900" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="wire" value="&lt;b&gt;Trên đường truyền và tại máy chủ Google&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Thấy được: người gửi, người nhận, thời gian, kích thước, tiêu đề thư — tức là siêu dữ liệu.&#10;&#10;Không thấy được: nội dung thư và tệp đính kèm.&lt;/font&gt;" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#b91c1c;">
          <mxGeometry x="400" y="400" width="380" height="400" as="geometry" />
        </mxCell>
        <mxCell id="r1" value="&lt;b&gt;6. Nhận thư&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Nhận diện khối OpenPGP trong thư&lt;/font&gt;" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#1d4ed8;">
          <mxGeometry x="840" y="100" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="r2" value="&lt;b&gt;7. Nhập cụm mật khẩu&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Hộp thoại của tiện ích, cách ly khỏi trang Gmail&lt;/font&gt;" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#1d4ed8;">
          <mxGeometry x="840" y="280" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="r3" value="&lt;b&gt;8. Giải mã và xác minh chữ ký&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Mở khóa riêng tư → khôi phục khóa phiên → giải mã → kiểm tra toàn vẹn và chữ ký&lt;/font&gt;" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1e3a8a;fontStyle=1;">
          <mxGeometry x="840" y="460" width="300" height="210" as="geometry" />
        </mxCell>
        <mxCell id="r4" value="&lt;b&gt;9. Hiển thị trong khung cách ly&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Kèm trạng thái chữ ký: hợp lệ, không hợp lệ, hoặc không có&lt;/font&gt;" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#15803d;">
          <mxGeometry x="840" y="700" width="300" height="170" as="geometry" />
        </mxCell>
        <mxCell id="note2" value="Bước 8 thất bại nếu bản mã bị sửa dù chỉ một ký tự: cơ chế kiểm tra toàn vẹn của OpenPGP từ chối bản mã thay vì trả về bản rõ sai. Xem Phụ lục kỹ thuật, phép thử D." parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;fontStyle=2;">
          <mxGeometry x="40" y="1080" width="1100" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e0" value="" parent="1" edge="1" source="s1" target="s2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="" parent="1" edge="1" source="s2" target="s3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="" parent="1" edge="1" source="s3" target="s4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
