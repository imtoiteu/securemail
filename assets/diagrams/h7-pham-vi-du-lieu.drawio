<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="securemail-dossier" type="device">
  <diagram name="Phạm vi dữ liệu phù hợp và ranh giới pháp lý" id="h7-pham-vi-du-lieu">
    <mxGraphModel dx="1180" dy="880" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Phạm vi dữ liệu phù hợp và ranh giới pháp lý" parent="1" vertex="1" style="text;html=1;align=center;fontSize=18;fontStyle=1;">
          <mxGeometry x="0" y="8" width="1180" height="30" as="geometry" />
        </mxCell>
        <mxCell id="ok1" value="&lt;b&gt;Phù hợp về kỹ thuật và pháp lý&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&#10;Tài liệu phục vụ giảng dạy, đề cương, đề thi chưa công bố&#10;&#10;Kết quả học tập và dữ liệu cá nhân của người học&#10;&#10;Tài liệu nghiên cứu, bản thảo chưa công bố&#10;&#10;Trao đổi nghiệp vụ nội bộ không thuộc danh mục bí mật nhà nước&#10;&#10;Dữ liệu cần bảo vệ khi truyền qua hạ tầng công cộng&lt;/font&gt;" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#15803d;">
          <mxGeometry x="30" y="90" width="360" height="560" as="geometry" />
        </mxCell>
        <mxCell id="warn" value="&lt;b&gt;Cần đánh giá và phê duyệt riêng&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&#10;Thông tin nội bộ nhạy cảm chưa được phân loại&#10;&#10;Dữ liệu có yêu cầu lưu vết và kiểm toán tập trung&#10;&#10;Trường hợp cần khôi phục khóa tập trung (key escrow)&#10;&#10;Cần có quy chế sử dụng của đơn vị trước khi triển khai&lt;/font&gt;" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#b45309;">
          <mxGeometry x="410" y="90" width="360" height="560" as="geometry" />
        </mxCell>
        <mxCell id="no" value="&lt;b&gt;Không áp dụng khi chưa có cơ sở pháp lý&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&#10;Thông tin thuộc danh mục bí mật nhà nước&#10;&#10;Việc truyền, nhận thông tin bí mật nhà nước qua mạng phải sử dụng sản phẩm mật mã và tuân thủ quy định về cơ yếu — Luật Bảo vệ bí mật nhà nước năm 2018 và Nghị định số 26/2020/NĐ-CP.&#10;&#10;Secure Mail chưa được kiểm định và chưa được cấp phép cho mục đích này.&lt;/font&gt;" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#b91c1c;">
          <mxGeometry x="790" y="90" width="360" height="560" as="geometry" />
        </mxCell>
        <mxCell id="note7" value="Hồ sơ này khẳng định năng lực kỹ thuật của giải pháp, không khẳng định tư cách pháp lý để bảo vệ bí mật nhà nước. Ranh giới này được nêu ngay từ đầu, không phải là hạn chế được phát hiện về sau." parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;fontStyle=2;">
          <mxGeometry x="30" y="690" width="1120" height="110" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>