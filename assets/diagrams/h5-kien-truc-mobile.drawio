        <mxCell id="e6" value="kiểm chứng" parent="1" edge="1" source="gold" target="wv" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
