<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="securemail-dossier" type="device">
  <diagram name="Quy trình xây dựng và kiểm chứng một bản phát hành" id="h6-quy-trinh-kiem-chung">
    <mxGraphModel dx="1180" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Quy trình xây dựng và kiểm chứng một bản phát hành" parent="1" vertex="1" style="text;html=1;align=center;fontSize=18;fontStyle=1;">
          <mxGeometry x="0" y="8" width="1180" height="30" as="geometry" />
        </mxCell>
        <mxCell id="src" value="&lt;b&gt;1. Mã nguồn&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Git, lịch sử đầy đủ, không chứa bí mật&lt;/font&gt;" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#1d4ed8;">
          <mxGeometry x="30" y="300" width="190" height="150" as="geometry" />
        </mxCell>
        <mxCell id="t1" value="&lt;b&gt;2. Kiểm thử đơn vị&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;449/449 đạt&#10;(bản máy tính)&lt;/font&gt;" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#15803d;">
          <mxGeometry x="270" y="110" width="220" height="150" as="geometry" />
        </mxCell>
        <mxCell id="t2" value="&lt;b&gt;3. Kiểm thử di động&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;68/68 đạt&#10;(cầu RPC và lõi)&lt;/font&gt;" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#15803d;">
          <mxGeometry x="270" y="300" width="220" height="150" as="geometry" />
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;4. Kiểm toán bản dịch&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;586/586 khóa&#10;0 lỗi chặn&lt;/font&gt;" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#15803d;">
          <mxGeometry x="270" y="490" width="220" height="150" as="geometry" />
        </mxCell>
        <mxCell id="build" value="&lt;b&gt;5. Biên dịch bản phát hành&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;grunt prod&#10;webpack, rút gọn mã&lt;/font&gt;" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1e3a8a;fontStyle=1;">
          <mxGeometry x="540" y="300" width="220" height="150" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="&lt;b&gt;6. Kiểm toán bề mặt mạng&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;verify-no-external-endpoints.sh&#10;4/4 điểm cuối đã gỡ: vắng mặt&lt;/font&gt;" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#15803d;">
          <mxGeometry x="810" y="110" width="240" height="160" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="&lt;b&gt;7. Kiểm chứng liên thông&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;interop-gnupg.mjs&#10;8/8 phép thử đạt với GnuPG 2.4.4&lt;/font&gt;" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#15803d;">
          <mxGeometry x="810" y="310" width="240" height="160" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="&lt;b&gt;8. Đo hiệu năng&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;benchmark-crypto.mjs&#10;Số liệu tại Phụ lục kỹ thuật&lt;/font&gt;" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#15803d;">
          <mxGeometry x="810" y="510" width="240" height="160" as="geometry" />
        </mxCell>
        <mxCell id="rel" value="&lt;b&gt;9. Đóng gói và niêm phong&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Tệp .zip kèm SHA-256, mã định danh cố định&lt;/font&gt;" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#b45309;">
          <mxGeometry x="30" y="550" width="190" height="170" as="geometry" />
        </mxCell>
        <mxCell id="note6" value="Các bước 6, 7 và 8 đều là kịch bản chạy được, kết quả kèm trong hồ sơ. Người thẩm định chạy lại được trên chính bản phát hành để tự kiểm chứng, không phải tin vào lời khẳng định." parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;fontStyle=2;">
          <mxGeometry x="30" y="770" width="1120" height="100" as="geometry" />
        </mxCell>
